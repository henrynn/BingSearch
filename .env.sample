# Copy this file to .env and fill in your local values.
# Do not commit .env with secrets.

# Web IQ direct API (only needed for webiq strategy)
WEBIQ_API_KEY=YOUR_WEBIQ_API_KEY
WEBIQ_URL=https://api.microsoft.ai/v3/search/web

# Foundry settings (used by foundry_bing_grounding and foundry_web_search)
FOUNDRY_PROJECT_ENDPOINT=https://YOUR_FOUNDRY_RESOURCE.ai.azure.com/api/projects/YOUR_PROJECT_NAME
FOUNDRY_MODEL_DEPLOYMENT_NAME=YOUR_MODEL_DEPLOYMENT_NAME

# Bing grounding connection (use either the connection name or the connection ID)
BING_PROJECT_CONNECTION_NAME=YOUR_BING_CONNECTION_NAME
# BING_PROJECT_CONNECTION_ID=/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP/providers/Microsoft.CognitiveServices/accounts/YOUR_ACCOUNT/projects/YOUR_PROJECT/connections/YOUR_CONNECTION_NAME

# Optional benchmark defaults
# DEFAULT_QUERY=Latest AI trends
